{
  "name": "tree-sitter-jerry",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Jerry language",
  "repository": "https://github.com/jeffscottbrown/jerry-zed",
  "license": "MIT",
  "main": "grammar.js",
  "devDependencies": {
    "tree-sitter-cli": "^0.22.0"
  },
  "scripts": {
    "build": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.jerry",
      "file-types": ["jer"],
      "highlights": "highlights.scm",
      "content-regex": "^\\s*(fn|class|let|include)\\b"
    }
  ]
}
